<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置：
  - 控制台输出：开发期间使用彩色日志
  - 文件输出：logs/base.yyyy-MM-dd.log（按天滚动）
  - 错误日志：logs/base-error.yyyy-MM-dd.log（仅 ERROR）
  - 保留 180 天
  - 单文件最大 100MB
-->
<configuration scan="true" scanPeriod="60 seconds">

  <springProperty scope="context" name="logPath" source="logging.path" defaultValue="${user.dir}/logs"/>
  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="base"/>
  <springProperty scope="context" name="maxHistory" source="logging.max-history" defaultValue="180"/>
  <springProperty scope="context" name="maxFileSize" source="logging.max-file-size" defaultValue="100MB"/>

  <!-- 彩色日志格式 -->
  <property name="LOG_PATTERN_CONSOLE"
    value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%thread] %logger{36} - %msg%n"/>
  <!-- 文件日志格式（含完整时间戳便于查询） -->
  <property name="LOG_PATTERN_FILE"
    value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{traceId:-}] - %msg%n"/>

  <!-- 控制台输出 -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN_CONSOLE}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- INFO 文件输出（按天滚动 + 最大保留 N 天 + 单文件上限） -->
  <appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${logPath}/${appName}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${logPath}/${appName}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>${maxFileSize}</maxFileSize>
      <maxHistory>${maxHistory}</maxHistory>
      <totalSizeCap>10GB</totalSizeCap>
      <cleanHistoryOnStart>false</cleanHistoryOnStart>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN_FILE}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ERROR 文件输出（按天滚动，仅记录 ERROR） -->
  <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${logPath}/${appName}-error.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${logPath}/${appName}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
      <maxFileSize>${maxFileSize}</maxFileSize>
      <maxHistory>${maxHistory}</maxHistory>
      <totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder>
      <pattern>${LOG_PATTERN_FILE}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- 异步包装，提升 IO 性能（基于 ArrayBlockingQueue） -->
  <appender name="ASYNC_INFO" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_INFO"/>
    <queueSize>2048</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
  </appender>
  <appender name="ASYNC_ERROR" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="FILE_ERROR"/>
    <queueSize>1024</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>true</neverBlock>
  </appender>

  <!-- 开发环境：DEBUG + 控制台输出 -->
  <springProfile name="dev">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="ASYNC_INFO"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </root>
    <logger name="com.zerocode.app" level="DEBUG"/>
  </springProfile>

  <!-- 生产/test环境：INFO + 文件输出 -->
  <springProfile name="!dev">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="ASYNC_INFO"/>
      <appender-ref ref="ASYNC_ERROR"/>
    </root>
    <logger name="com.zerocode.app" level="INFO"/>
  </springProfile>

  <!-- 特定 logger 级别配置 -->
  <logger name="org.springframework" level="WARN"/>
  <logger name="org.hibernate" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>
  <logger name="com.baomidou.mybatisplus" level="WARN"/>
  <logger name="org.apache.tomcat" level="WARN"/>
  <logger name="com.netflix.discovery" level="ERROR"/>

</configuration>
